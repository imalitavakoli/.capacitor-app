{
  "appId": "com.example.app",
  "appName": "capacitor-app",
  "bundledWebRuntime": false,
  "webDir": "dist",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0
    },
    
    "EdgeToEdge": {
      "backgroundColor": "#ff0000"
    },

    "Keyboard": {
      "resize": "none",
      "style": "default",
      "resizeOnFullScreen": false
    },

    "SystemBars": {
      "insetsHandling": "disable"
    }
  }
}